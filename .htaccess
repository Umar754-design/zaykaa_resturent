# Apache Configuration - Zaykaa Café & Restaurant

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block dev/internal folders and VCS metadata
    RewriteRule ^(scratch|database|config|storage|node_modules|\.git|\.claude)(/|$) - [F,L,NC]
</IfModule>

# Block secrets, dumps, and project tooling files
<FilesMatch "(^\.env.*|\.(sql|md|log|py|sh|ini|bak|lock)$|^(package(-lock)?\.json|composer\.(json|lock))$)">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
